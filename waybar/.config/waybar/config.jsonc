{
    "layer": "top",
    "modules-left": ["hyprland/workspaces", "tray", "keyboard-state", "hyprland/submap"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/network", "bluetooth", "custom/caffeine", "custom/sysstats", "custom/media", "pulseaudio", "backlight", "battery", "clock"],
    "custom/sysstats": {
        "exec": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/sysstats.sh status",
        "return-type": "json",
        "interval": 5
    },
    "custom/network": {
        "exec": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/network.sh status",
        "on-click": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/network.sh toggle",
        "return-type": "json",
        "interval": 30
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "on-click": "blueberry"
    },
    "tray": {
        "icon-size": 16,
        "show-passive-items": true,
        "spacing": 8
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "custom/caffeine": {
        "exec": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/caffeine.sh status",
        "on-click": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/caffeine.sh toggle",
        "return-type": "json",
        "interval": "once",
        "signal": 10
    },
    "custom/media": {
        "exec": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/media.sh status",
        "on-click": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/media.sh play-pause",
        "on-click-middle": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/media.sh next",
        "on-click-right": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/media.sh previous",
        "return-type": "json",
        "interval": 3,
        "signal": 11,
        "max-length": 36
    },
    "hyprland/window": {
        "max-length": 50
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}% ",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋋",
            "headset": "󰋋",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰏲",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "scroll-step": 5
    },
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}",
        "tooltip": false
    }
}
