{
    "layer": "top",
    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/network", "custom/caffeine", "custom/sysstats", "pulseaudio", "backlight", "battery", "clock"],
    "custom/sysstats": {
        "exec": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/sysstats.sh status",
        "return-type": "json",
        "interval": 5
    },
    "custom/network": {
        "exec": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/network.sh status",
        "on-click": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/network.sh toggle",
        "return-type": "json",
        "interval": 30
    },
    "custom/caffeine": {
        "exec": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/caffeine.sh status",
        "on-click": "/home/skydogzz/dotfiles/hypr/.config/hypr/scripts/caffeine.sh toggle",
        "return-type": "json",
        "interval": "once",
        "signal": 10
    },
    "hyprland/window": {
        "max-length": 50
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}% ",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋋",
            "headset": "󰋋",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰏲",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-click": "brightnessctl set 50%",
        "scroll-step": 5
    },
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}"
    }
}
