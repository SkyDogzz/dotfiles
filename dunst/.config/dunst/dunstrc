[global]
    font = JetBrains Mono 10
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    word_wrap = yes
    ignore_newline = no
    background = "#11111b"
    foreground = "#cdd6f4"
    frame_color = "#fab387"
    separator_color = "#fab387"
    frame_width = 2
    corner_radius = 8
    timeout = 5
    offset = (12, 12)
    origin = top-right
    transparency = 10

[screenshot]
    appname = "Screenshot"
    script = ~/.config/dunst/dunst_notif_action

[urgency_low]
    background = "#181825"
    foreground = "#cdd6f4"
    frame_color = "#45475a"

[urgency_normal]
    background = "#11111b"
    foreground = "#cdd6f4"
    frame_color = "#fab387"

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f5e0dc"
    frame_color = "#f38ba8"
