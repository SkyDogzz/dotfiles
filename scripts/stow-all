#!/bin/sh
# Stow all dotfiles packages except those listed
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
STOW_DIR="${STOW_DIR:-$(CDPATH= cd -- "$script_dir/.." && pwd)}"
IGNORE="greetd scripts"

for d in "$STOW_DIR"/*/; do
  pkg=$(basename "$d")
  for ignore in $IGNORE; do
    if [ "$pkg" = "$ignore" ]; then
      continue 2
    fi
  done
  if ! stow -R -d "$STOW_DIR" "$pkg" 2>&1; then
    printf "  [FAIL] %s\n" "$pkg"
  else
    printf "  stow %s\n" "$pkg"
  fi
done
