#!/usr/bin/env bash
set -euo pipefail

connection_name="${1:-iPhone de Thomas (2)}"

nmcli connection modify "$connection_name" \
  connection.autoconnect yes \
  connection.autoconnect-priority 100 \
  connection.autoconnect-retries 0

nmcli -f connection.id,connection.autoconnect,connection.autoconnect-priority,connection.autoconnect-retries \
  connection show "$connection_name"
