#!/usr/bin/env bash
set -euo pipefail

stow_dir="${STOW_DIR:-$HOME/dotfiles}"
target_dir="${STOW_TARGET:-$HOME}"
ignore_packages="${STOW_IGNORE_PACKAGES:-greetd scripts}"
ignore_paths="${STOW_IGNORE_PATHS:-node_modules dist build coverage .git .cache vendor}"

if ! command -v realpath >/dev/null 2>&1; then
  printf '[FAIL] realpath is required\n' >&2
  exit 1
fi

status=0

should_ignore_path() {
  local path="$1"
  local needle
  for needle in $ignore_paths; do
    if [[ "$path" == *"/$needle/"* || "$path" == *"/$needle" || "$path" == "$needle"* ]]; then
      return 0
    fi
  done
  return 1
}

for pkgdir in "$stow_dir"/*/; do
  [[ -d "$pkgdir" ]] || continue

  pkg="${pkgdir%/}"
  pkg="${pkg##*/}"

  for ignore in $ignore_packages; do
    if [[ "$pkg" == "$ignore" ]]; then
      continue 2
    fi
  done

  while IFS= read -r -d '' source; do
    if should_ignore_path "${source#"$stow_dir"/}"; then
      continue
    fi

    rel_path="${source#"$pkgdir"}"
    target="${target_dir}/${rel_path}"

    if [[ ! -e "$target" ]]; then
      printf '[FAIL] missing: %s -> %s\n' "$target" "$source"
      status=1
      continue
    fi

    if [[ ! -L "$target" ]]; then
      printf '[FAIL] not a symlink: %s\n' "$target"
      status=1
      continue
    fi

    source_real="$(realpath "$source")"
    target_real="$(realpath "$target")"

    if [[ "$source_real" != "$target_real" ]]; then
      printf '[FAIL] wrong target: %s -> %s (expected %s)\n' "$target" "$target_real" "$source_real"
      status=1
      continue
    fi
  done < <(find "$pkgdir" \( \
    -path '*/node_modules/*' -o \
    -path '*/dist/*' -o \
    -path '*/build/*' -o \
    -path '*/coverage/*' -o \
    -path '*/.git/*' -o \
    -path '*/.cache/*' -o \
    -path '*/vendor/*' \
  \) -prune -o \( -type f -o -type l \) -print0)
done

exit "$status"
