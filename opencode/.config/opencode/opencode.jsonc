{
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "$schema": "https://opencode.ai/config.json",
  // "model": "ollama/qwen3.5:9b",
  // "small_model": "ollama/qwen3.5:4b",
  "model": "openrouter/deepseek/deepseek-v4-flash",
  "small_model": "openrouter/deepseek/deepseek-v4-flash",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B"
        },
        "qwen3.5:4b": {
          "name": "Qwen 3.5 4B"
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B"
        },
        "deepseek-r1:7b": {
          "name": "DeepSeek R1 7B"
        },
        "qwen3:8b": {
          "name": "Qwen 3 8B"
        },
        "mistral:7b": {
          "name": "Mistral 7B"
        }
      }
    }
  },
  "lsp": true,
  "formatter": true,
  "permission": {
    "list": "allow",
    "edit": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "deny",
    "question": "allow",
    "external_directory": {
      "/tmp/*": "allow",
      "~/.config/*": "allow",
      "~/dotfiles/**": "allow",
      "~/projects/**": "allow",
      "~/downloads/**": "allow",
      "~/Documents/**": "allow",
      "~/Templates/**": "allow",
      "/etc/*": "allow",
      "/usr/*": "allow"
    },
    "read": {
      "**": "allow",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.ollama/id_ed25519*": "deny",
      "~/.pki/**": "deny",
      "~/.netrc": "deny",
      "~/.aws/**": "deny",
      "~/.docker/config.json": "deny",
      "~/.npmrc": "deny",
      "~/.zsh_history": "deny",
      "~/.bash_history": "deny",
      "~/.python_history": "deny",
      "**/.env*": "deny",
      "**/secret*": "deny",
      "**/secrets/**": "deny",
      "**/token*": "deny",
      "**/tokens*": "deny",
      "**/auth*": "deny",
      "**/credentials*": "deny",
      "**/*cred*": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.cert": "deny",
      "**/*.crt": "deny",
      "**/*.ovpn": "deny",
      "**/*.log": "deny",
      "**/logs/**": "deny",
      "**/.git-credentials": "deny",
      "**/service-account*": "deny",
      "**/passwd*": "deny",
      "**/password*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "sd *": "allow",
      "procs *": "allow",
      "duf *": "allow",
      "dust *": "allow",
      "btop": "allow",
      "htop": "allow",
      "nvtop": "allow",
      "z *": "allow",
      "cat *": "allow",
      "which *": "allow",
      "type *": "allow",
      "uname *": "allow",
      "fastfetch": "allow",
      "lsblk *": "allow",
      "df *": "allow",
      "free *": "allow",
      "uptime": "allow",
      "ps *": "allow",
      "lsof *": "allow",
      "pwd": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "date": "allow",
      "timedatectl *": "allow",
      "hostnamectl *": "allow",
      "journalctl *": "allow",
      "unzip *": "allow",
      "tar *": "allow",
      "gzip *": "allow",
      "dog *": "allow",
      "tldr *": "allow",
      "man *": "allow",
      "stow *": "allow",
      "killall *": "allow",
      "ls *": "allow",
      "eza *": "allow",
      "bat *": "allow",
      "fd *": "allow",
      "rg *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "find *": "allow",
      "history": "allow",
      "env": "allow",
      "alias": "allow",
      "printenv *": "allow",
      "tee *": "allow",
      "xargs *": "allow",
      "tr *": "allow",
      "cut *": "allow",
      "uniq *": "allow",
      "watch *": "allow",
      "id *": "allow",
      "whoami": "allow",
      "hostname *": "allow",
      "nproc": "allow",
      "nvidia-smi *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "ln *": "allow",
      "rmdir *": "allow",
      "just *": "allow",
      "lazygit": "allow",
      "yazi": "allow",
      "hyprctl *": "allow",
      "brightnessctl *": "allow",
      "wpctl *": "allow",
      "grim *": "allow",
      "slurp *": "allow",
      "swappy *": "allow",
      "wl-copy *": "allow",
      "wl-paste": "allow",
      "cliphist *": "allow",
      "notify-send *": "allow",
      "dunstify *": "allow",
      "systemctl *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "http *": "ask",
      "ping *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "npx *": "ask",
      "npm *": "ask",
      "pip *": "ask",
      "cargo *": "ask",
      "go *": "ask",
      "gh *": "ask",
      "tmux *": "ask",
      "git *": "allow",
      "git push": "ask",
      "git push *": "ask",
      "rm *": "ask",
      "rm -rf *": "ask",
      "sudo *": "ask",
      "pacman *": "ask"
    }
  },
  "compaction": {
    "prune": false
  },
  // "agent": {
  //   "plan": { "model": "ollama/qwen3.5:9b" },
  //   "build": { "model": "ollama/qwen2.5-coder:7b" }
  // },
  "agent": {
    "plan": {
      "model": "openrouter/deepseek/deepseek-v4-flash"
    },
    "build": {
      "model": "openrouter/deepseek/deepseek-v4-flash"
    }
  },
  "plugin": [
    "./plugins/permission-notify.js",
    "./plugins/notify-done.js"
  ]
}
