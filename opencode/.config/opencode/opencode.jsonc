{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.5:9b",
  "small_model": "ollama/qwen3.5:4b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B"
        },
        "qwen3.5:4b": {
          "name": "Qwen 3.5 4B"
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B"
        },
        "deepseek-r1:7b": {
          "name": "DeepSeek R1 7B"
        },
        "qwen3:8b": {
          "name": "Qwen 3 8B"
        },
        "mistral:7b": {
          "name": "Mistral 7B"
        }
      }
    }
  },
  "lsp": true,
  "permission": {
    "bash": {
      "git *": "allow",
      "git push": "ask",
      "git push *": "ask"
    }
  }
}
